NODE_ENV=production
WS_HOST=127.0.0.1
WS_PORT=3001
NODE_OPTIONS=--max-old-space-size=256
RESTART_ON_DISCONNECT=1
DEBUG_WHATSAPP=0
# Optional explicit own-message test group; keep disabled outside testing.
WHATSAPP_ALLOW_TEST_GROUP_IN_PRODUCTION=0
# Keep off: resource interception may prevent image downloads.
OPTIMIZE_WHATSAPP=0

# Optional outgoing offers. Set a random shared secret (at least 32 characters)
# in this file on the server; never commit the real value.
WHATSAPP_SEND_SECRET=
WHATSAPP_SEND_HOST=127.0.0.1
WHATSAPP_SEND_PORT=3002
WHATSAPP_SEND_LEDGER=./sessions/offer-deliveries.json
