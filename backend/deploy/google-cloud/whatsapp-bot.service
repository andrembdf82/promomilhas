[Unit]
Description=Airlert WhatsApp Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=andremarquesdf
Group=andremarquesdf
WorkingDirectory=/home/andremarquesdf/whatsapp-bot
EnvironmentFile=/etc/airlert/whatsapp.env
ExecStart=/usr/local/bin/node /home/andremarquesdf/whatsapp-bot/index.js
Restart=always
RestartSec=20
TimeoutStopSec=45
KillMode=control-group
UMask=0077
MemoryAccounting=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=whatsapp-bot

[Install]
WantedBy=multi-user.target
